{
  "name": "Rylo Translate",
  "short_name": "Rylo Translate",
  "scope": "./",
  "id": "rylo.com/sign/translate",
  "start_url": "./",
  "display": "standalone",
  "theme_color": "#F57C00",
  "background_color": "#FFF",
  "user_preferences": {
    "color_scheme_dark": {
      "theme_color": "#F57C00",
      "background_color": "#000"
    },
    "color_scheme_light": {
      "theme_color": "#F57C00",
      "background_color": "#FFF"
    }
  },
  "icons": [
    {
      "src": "assets/icons/generated/manifest-icon-192.maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/generated/manifest-icon-192.maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/generated/manifest-icon-512.maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/generated/manifest-icon-512.maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+sign",
      "url": "./?text=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/*": [".pose"]
      },
      "icons": [],
      "launch_type": "multiple-clients"
    }
  ],
  "shortcuts": [
    {
      "name": "Translate sign language",
      "short_name": "Signed-to-Spoken",
      "description": "Open signed-to-spoken language translation",
      "icons": [
        {
          "src": "assets/icons/generated/manifest-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "url": "./?direction=signed-to-spoken"
    },
    {
      "name": "Translate spoken language",
      "short_name": "Spoken-to-Signed",
      "description": "Open spoken-to-signed language translation",
      "icons": [
        {
          "src": "assets/icons/generated/manifest-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "url": "./?direction=spoken-to-signed"
    }
  ],
  "description": "Effortless real-time sign language translation by Rylo",
  "screenshots": []
}
